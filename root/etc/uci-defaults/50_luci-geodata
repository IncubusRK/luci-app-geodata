#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# First-boot setup for luci-app-geodata.

# Drop LuCI caches so the new menu entry and views show up.
rm -f /tmp/luci-indexcache.*
rm -rf /tmp/luci-modulecache/

# Reload rpcd so the luci.geodata ucode plugin is registered.
[ -x /etc/init.d/rpcd ] && /etc/init.d/rpcd reload

exit 0