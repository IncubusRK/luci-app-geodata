msgid "Invalid file selection."
msgstr "Неверный выбор файлов."

#: htdocs/luci-static/resources/view/geodata/status.js:55
msgid "The update worker is missing or not executable."
msgstr "Программа обновления отсутствует или не исполняема."

#: htdocs/luci-static/resources/view/geodata/status.js:56
msgid "Failed to start the update worker."
msgstr "Не удалось запустить программу обновления."

#: htdocs/luci-static/resources/view/geodata/status.js:57
msgid "The update worker terminated unexpectedly."
msgstr "Программа обновления неожиданно завершилась."

#: htdocs/luci-static/resources/view/geodata/status.js:58
msgid "Download failed"
msgstr "Ошибка скачивания"

#: htdocs/luci-static/resources/view/geodata/status.js:59
msgid "The file does not look like a valid geodata protobuf"
msgstr "Файл не похож на корректный protobuf geodata"

#: htdocs/luci-static/resources/view/geodata/status.js:60
msgid "Failed to install the file (atomic rename failed)."
msgstr "Не удалось установить файл (атомарное переименование не выполнено)."

#: htdocs/luci-static/resources/view/geodata/status.js:61
msgid "Failed to compute SHA-256."
msgstr "Не удалось вычислить SHA-256."

#: htdocs/luci-static/resources/view/geodata/status.js:62
msgid "No valid download URL is configured."
msgstr "Не задан корректный URL для скачивания."

#: htdocs/luci-static/resources/view/geodata/status.js:63
msgid "The custom geoip.dat URL is invalid (HTTPS is required)."
msgstr "URL пользовательского geoip.dat некорректен (требуется HTTPS)."

#: htdocs/luci-static/resources/view/geodata/status.js:64
