msgid "Daily"
msgstr "Ежедневно"

#: htdocs/luci-static/resources/view/geodata/settings.js:59
msgid "Weekly"
msgstr "Еженедельно"

#: htdocs/luci-static/resources/view/geodata/settings.js:64
msgid "Hour (0-23)"
msgstr "Час (0-23)"

