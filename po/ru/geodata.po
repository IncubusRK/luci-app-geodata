#: htdocs/luci-static/resources/view/geodata/settings.js:15
msgid "The URL must start with https:// and contain no spaces or control characters."
msgstr "URL должен начинаться с https:// и не содержать пробелов и управляющих символов."

#: htdocs/luci-static/resources/view/geodata/settings.js:23
msgid "Geodata settings"
msgstr "Настройки geodata"

#: htdocs/luci-static/resources/view/geodata/settings.js:24
msgid "Source and update schedule for the xray geodata files (geoip.dat / geosite.dat) in /usr/share/v2ray/."
msgstr "Источник и расписание обновления файлов geodata xray (geoip.dat / geosite.dat) в /usr/share/v2ray/."

#: htdocs/luci-static/resources/view/geodata/settings.js:26
msgid "General"
msgstr "Общие"

#: htdocs/luci-static/resources/view/geodata/settings.js:30 htdocs/luci-static/resources/view/geodata/status.js:277
msgid "Geodata source"
msgstr "Источник geodata"

#: htdocs/luci-static/resources/view/geodata/settings.js:31
msgid "Loyalsoldier is the recommended default: it contains all required codes (including TELEGRAM) and keeps xray at about 250 MB of RAM. The runetfreedom geosite.dat is about 89 MB and makes xray use about 1.3 GB of RAM. v2fly geoip.dat lacks the TELEGRAM code, which breaks xray configurations using geoip:telegram (EOF error). Custom URLs must use HTTPS."
msgstr "Loyalsoldier — рекомендуемый вариант по умолчанию: он содержит все необходимые коды (включая TELEGRAM), а xray занимает около 250 МБ ОЗУ. geosite.dat от runetfreedom занимает около 89 МБ, и xray с ним использует около 1,3 ГБ ОЗУ. В geoip.dat от v2fly нет кода TELEGRAM, из-за чего конфигурации xray с geoip:telegram не запускаются (ошибка EOF). Пользовательские URL должны использовать HTTPS."

#: htdocs/luci-static/resources/view/geodata/settings.js:35 htdocs/luci-static/resources/view/geodata/status.js:23
msgid "Custom URLs"
msgstr "Пользовательские URL"

#: htdocs/luci-static/resources/view/geodata/settings.js:39
msgid "Custom geoip.dat URL"
msgstr "URL пользовательского geoip.dat"

#: htdocs/luci-static/resources/view/geodata/settings.js:40
msgid "HTTPS URL of a custom geoip.dat file."
msgstr "HTTPS-URL пользовательского файла geoip.dat."

#: htdocs/luci-static/resources/view/geodata/settings.js:45
msgid "Custom geosite.dat URL"
msgstr "URL пользовательского geosite.dat"

#: htdocs/luci-static/resources/view/geodata/settings.js:46
msgid "HTTPS URL of a custom geosite.dat file. For the v2fly domain-list-community this is dlc.dat; it will be installed as geosite.dat."
msgstr "HTTPS-URL пользовательского файла geosite.dat. Для v2fly domain-list-community это dlc.dat; он будет установлен как geosite.dat."

#: htdocs/luci-static/resources/view/geodata/settings.js:51 htdocs/luci-static/resources/view/geodata/status.js:307
msgid "Automatic updates"
msgstr "Автоматические обновления"

#: htdocs/luci-static/resources/view/geodata/settings.js:52
msgid "Download and install geodata updates on a schedule (a cron job in /etc/crontabs/root). Disabled by default."
msgstr "Скачивать и устанавливать обновления geodata по расписанию (задание cron в /etc/crontabs/root). По умолчанию выключено."

#: htdocs/luci-static/resources/view/geodata/settings.js:56
msgid "Schedule"
msgstr "Расписание"

#: htdocs/luci-static/resources/view/geodata/settings.js:57
