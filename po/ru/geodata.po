msgid "Minute (0-59)"
msgstr "Минута (0-59)"

#: htdocs/luci-static/resources/view/geodata/settings.js:72
msgid "Minute of the hour for the scheduled update."
msgstr "Минута часа для обновления по расписанию."

#: htdocs/luci-static/resources/view/geodata/settings.js:78
msgid "Day of week"
msgstr "День недели"

